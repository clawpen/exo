# Standalone Cargo.toml for container builds
# This replaces the workspace member version for Docker builds

[package]
name = "exo-agent"
version = "0.1.0"
edition = "2021"
description = "Lightweight agent runtime for Exo containers"

[dependencies]
# Async runtime
tokio = { version = "1", features = ["full"] }
async-trait = "0.1"

# HTTP client for LLM APIs
reqwest = { version = "0.12", features = ["json", "rustls-tls"] }

# Serialization
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# Database for memory
sqlx = { version = "0.7", features = ["sqlite", "runtime-tokio", "tls-rustls"] }

# Error handling
anyhow = "1"
thiserror = "1"

# Logging
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

# Async utilities
futures = "0.3"

# Configuration
toml = "0.8"

# CLI
clap = { version = "4", features = ["derive"] }

# UUID for session IDs
uuid = { version = "1", features = ["v4", "serde"] }

# Time handling
chrono = { version = "0.4", features = ["serde"] }

[[bin]]
name = "exo-agent"
path = "src/main.rs"
