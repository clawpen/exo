# Exo Agent Containerfile - Pre-built binary
# Copy binary from host build instead of building in container
#
# Build: 
#   cargo build --release -p exo-agent
#   docker build -t exo-agent:latest -f Containerfile.prebuilt .
#
# Run:   
#   docker run -it --rm -e ZAI_API_KEY=xxx exo-agent:latest

FROM ubuntu:noble

# Install minimal runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m agent

# Create directories
RUN mkdir -p /app /data /workspace && \
    chown -R agent:agent /app /data /workspace

WORKDIR /workspace

# Copy pre-built binary
COPY target/release/exo-agent /app/exo-agent

# Copy default config
COPY images/exo-agent/agent.toml /app/config.toml

# Set permissions
RUN chmod +x /app/exo-agent && chown agent:agent /app/exo-agent /app/config.toml

# Switch to non-root
USER agent

# Default environment
ENV RUST_LOG=info
ENV EXO_AGENT_CONFIG=/app/config.toml

# Expose workspace
VOLUME ["/workspace", "/data"]

# Run agent
ENTRYPOINT ["/app/exo-agent"]
CMD ["--config", "/app/config.toml"]
