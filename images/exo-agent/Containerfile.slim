# Exo Agent - Ultra-slim variant
# No SQLite, no tools - just LLM chat
# Target: <10MB

FROM rust:1.75-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/exo-agent ./crates/exo-agent

# Build with minimal features
RUN cargo build --release -p exo-agent --no-default-features

# ============================================
# Scratch image - absolute minimum
# ============================================
FROM scratch

COPY --from=builder /build/target/release/exo-agent /exo-agent

# CA certs for HTTPS
COPY --from=alpine:3.19 /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

ENTRYPOINT ["/exo-agent"]
