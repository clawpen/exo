# Exo Agent Containerfile
# Minimal container for the exo-agent runtime
#
# Build from repo root:
#   docker build -t exo-agent:latest -f images/exo-agent/Containerfile .
# Run:   docker run -it --rm -e ZAI_API_KEY=xxx exo-agent:latest

# ============================================
# Stage 1: Build
# ============================================
ARG RUST_VERSION=1.92
FROM rust:${RUST_VERSION}-alpine AS builder

RUN apk add --no-cache musl-dev sqlite-dev

WORKDIR /build

# Build from the checked-in workspace + lockfile so Docker uses the same
# dependency graph as local/CI builds. .dockerignore keeps target/ and scratch
# files out of the context.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build release binary using the checked-in lockfile for reproducible Docker
# builds. --locked makes accidental dependency drift fail fast.
RUN cargo build --release -p exo-agent --locked

# ============================================
# Stage 2: Runtime
# ============================================
FROM alpine:3.19

# Install minimal runtime deps
RUN apk add --no-cache ca-certificates sqlite-libs

# Create app user
RUN adduser -D -u 1000 agent

# Create directories
RUN mkdir -p /app /data /workspace && \
    chown -R agent:agent /app /data /workspace

WORKDIR /workspace

# Copy binary from builder
COPY --from=builder --chown=agent:agent /build/target/release/exo-agent /app/exo-agent

# Copy default config (optional)
COPY --chown=agent:agent images/exo-agent/agent.toml /app/config.toml

# Switch to non-root
USER agent

# Default environment
ENV RUST_LOG=info
ENV EXO_AGENT_CONFIG=/app/config.toml

# Expose workspace
VOLUME ["/workspace", "/data"]

# Run agent
ENTRYPOINT ["/app/exo-agent"]
CMD ["--config", "/app/config.toml"]
